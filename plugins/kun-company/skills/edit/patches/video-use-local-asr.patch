diff --git a/helpers/transcribe_local.py b/helpers/transcribe_local.py
new file mode 100644
index 0000000..bee3490
--- /dev/null
+++ b/helpers/transcribe_local.py
@@ -0,0 +1,82 @@
+"""Local transcription with mlx-whisper, shaped like an ElevenLabs Scribe response.
+
+Drop-in for call_scribe(): returns {"language_code", "text", "words"} where words
+are Scribe-style entries — type "word" with start/end/speaker_id, and type
+"spacing" for every inter-word gap — so pack_transcripts, timeline_view and
+render read it unchanged.
+
+Runs the `mlx_whisper` CLI (installed with `uv tool install mlx-whisper`) rather
+than importing it, so the video-use venv stays light. Apple Silicon only.
+
+Env:
+    VIDEO_USE_WHISPER_MODEL  default mlx-community/whisper-large-v3-turbo
+    VIDEO_USE_WHISPER_BIN    default mlx_whisper (on PATH)
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import tempfile
+from pathlib import Path
+
+DEFAULT_MODEL = "mlx-community/whisper-large-v3-turbo"
+
+# Whisper drops disfluencies unless the prompt shows them. Seeding the decoder with
+# fillers in both languages keeps "umm" / "يعني" in the transcript so they can be cut.
+FILLER_PROMPT = {
+    "ar": "أممم، آآ، يعني، طيب، إيه... أه، خلاص.",
+    "en": "Umm, uh, like, you know, so... uh, okay.",
+}
+
+
+def _bin() -> str:
+    b = os.environ.get("VIDEO_USE_WHISPER_BIN") or shutil.which("mlx_whisper")
+    if not b:
+        raise RuntimeError("mlx_whisper not found — run: uv tool install mlx-whisper")
+    return b
+
+
+def call_local(audio_path: Path, language: str | None = None) -> dict:
+    model = os.environ.get("VIDEO_USE_WHISPER_MODEL", DEFAULT_MODEL)
+    with tempfile.TemporaryDirectory() as tmp:
+        cmd = [
+            _bin(), str(audio_path),
+            "--model", model,
+            "--word-timestamps", "True",
+            "--condition-on-previous-text", "False",
+            "--output-format", "json",
+            "--output-dir", tmp,
+            "--verbose", "False",
+        ]
+        if language:
+            cmd += ["--language", language]
+        prompt = FILLER_PROMPT.get(language) if language else None
+        if prompt:
+            cmd += ["--initial-prompt", prompt]
+        subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL)
+        raw = json.loads((Path(tmp) / f"{audio_path.stem}.json").read_text())
+
+    words: list[dict] = []
+    prev_end: float | None = None
+    for seg in raw.get("segments", []):
+        for w in seg.get("words", []):
+            text = (w.get("word") or "").strip()
+            if not text:
+                continue
+            start, end = float(w["start"]), float(w["end"])
+            if prev_end is not None and start > prev_end:
+                words.append({"text": " ", "start": prev_end, "end": start,
+                              "type": "spacing", "speaker_id": "speaker_0"})
+            words.append({"text": text, "start": start, "end": end, "type": "word",
+                          "speaker_id": "speaker_0", "logprob": w.get("probability")})
+            prev_end = end
+
+    return {
+        "language_code": raw.get("language") or language,
+        "text": (raw.get("text") or "").strip(),
+        "words": words,
+        "asr": f"mlx-whisper:{model}",
+    }
