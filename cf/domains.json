      "registrar": "Namecheap",
      "renewal": {
        "autoRenew": "unverified",
        "autoRenewVerifiedAt": null,
        "where": "namecheap.com → Domain List → abdoutgroup.com → Auto-Renew"
      },
      "mail": null,
      "web": true
    },
    {
      "name": "nmbdsd.org",
      "role": "watch only",
      "registrar": "Namecheap",
      "renewal": {
        "autoRenew": "unverified",
        "autoRenewVerifiedAt": null,
        "where": "namecheap.com → Domain List → nmbdsd.org → Auto-Renew"
      },
      "mail": "skip",
