{
  "$comment": "The Video production line as data: the 14 stages (the same keys, order and files as STAGES in .claude/skills/produce/scripts/produce.mjs; `station.mjs lint` fails when they drift) and the tool ladder. `owns` names the choices in settings.json that belong to a stage; `ask` says who drafts the stage's spec when it is opened in the app (`script`: the standard choices only, no model; `agent`: the video agent on the read-only plan route); `pieces` is the ladder per kind of piece, cheapest first, each rung an id in `tools`. A tool with `staged: true` is listed and never used until a /decide entry switches it on. `lane` is a row of .claude/engine.json → lanes and is never `escalate`. Read by `station.mjs stage`, `produce lock|plan` and the formulas. Docs: content/docs/station.mdx, content/docs/produce.mdx.",
  "dept": "video",
  "stages": [
    {
      "key": "request",
      "n": 1,
      "group": "idea",
      "label": { "en": "Request", "ar": "الطلب" },
      "dir": "01-brief",
      "file": "01-brief/request.json",
      "gate": null,
      "ask": "script",
      "tool": "produce",
      "lane": "script",
      "owns": ["kind", "audience", "version", "platform", "ratio", "length"],
      "inputs": []
    },
    {
      "key": "research",
      "n": 2,
      "group": "idea",
      "label": { "en": "Research", "ar": "البحث" },
      "dir": "02-research",
      "file": "02-research/product-research.md",
      "gate": null,
      "ask": "script",
      "tool": "explore",
      "lane": "research",
      "owns": [],
      "inputs": ["01-brief/request.json"]
    },
    {
      "key": "brief",
      "n": 3,
      "group": "idea",
      "label": { "en": "Brief", "ar": "الملخص" },
      "dir": "01-brief",
      "file": "01-brief/creative-brief.md",
      "gate": null,
      "ask": "agent",
      "tool": "video-agent",
      "lane": "judge",
      "owns": [],
      "inputs": ["01-brief/request.json", "02-research/product-research.md"]
    },
    {
      "key": "script",
      "n": 4,
      "group": "story",
      "label": { "en": "Script", "ar": "السكربت" },
      "dir": "03-script",
      "file": "03-script/script.md",
      "gate": "script",
      "ask": "agent",
      "tool": "video-agent",
      "lane": "judge",
      "owns": ["structure"],
      "inputs": [
        "01-brief/creative-brief.md",
        "02-research/product-research.md"
      ]
    },
    {
      "key": "storyboard",
      "n": 5,
      "group": "story",
      "label": { "en": "Storyboard", "ar": "القصة المصورة" },
      "dir": "04-storyboard",
      "file": "04-storyboard/shot-list.json",
      "gate": null,
      "ask": "agent",
      "tool": "video-agent",
      "lane": "build",
      "owns": [],
      "inputs": ["03-script/script.md"]
    },
    {
      "key": "assets",
      "n": 6,
      "group": "make",
      "label": { "en": "Assets", "ar": "الأصول" },
      "dir": "05-assets",
      "file": "05-assets/asset-manifest.json",
      "gate": null,
      "ask": "script",
      "tool": "shoot",
      "lane": "build",
      "owns": ["stills"],
      "inputs": ["04-storyboard/shot-list.json"],
      "pieces": {
        "capture": ["shoot", "record"],
        "still": ["gemini-web", "chatgpt-seat", "higgs"],
        "motion": ["hyperframes", "carousel"]
      }
    },
    {
      "key": "visual",
      "n": 7,
      "group": "make",
      "label": { "en": "Visual", "ar": "المرئيات" },
      "dir": "06-production",
      "file": "06-production/visual-manifest.json",
      "gate": "look",
      "ask": "agent",
      "tool": "blender",
      "lane": "build",
      "owns": ["look", "threed"],
      "inputs": [
        "04-storyboard/shot-list.json",
        "05-assets/asset-manifest.json"
      ],
      "pieces": {
        "3d": ["blender", "blender-order"],
        "still": ["gemini-web", "chatgpt-seat", "higgs"],
        "clip": ["gemini-seat-video", "veo-api", "higgs", "fal"],
        "motion": ["hyperframes", "carousel"],
        "capture": ["shoot", "record"]
      }
    },
    {
      "key": "audio",
      "n": 8,
      "group": "make",
      "label": { "en": "Audio", "ar": "الصوت" },
      "dir": "07-audio",
      "file": "07-audio/audio-package.json",
      "gate": null,
      "ask": "script",
      "tool": "voice",
      "lane": "script",
      "owns": ["voice", "music"],
      "inputs": ["03-script/script.md"],
      "pieces": {
        "voice": ["voice", "chatterbox", "elevenlabs"],
        "music": ["brand-bed", "lyria", "media-use", "epidemic"],
        "effects": ["media-use", "elevenlabs"]
      }
    },
    {
      "key": "edit",
      "n": 9,
      "group": "make",
      "label": { "en": "Edit", "ar": "المونتاج" },
      "dir": "06-production/editing",
      "file": "06-production/editing/edit-project.json",
      "gate": null,
      "ask": "script",
      "tool": "filmcraft",
      "lane": "build",
      "owns": ["captions", "editor"],
      "inputs": [
        "06-production/visual-manifest.json",
        "07-audio/audio-package.json"
      ],
      "pieces": {
        "edit": ["filmcraft", "video-use"]
      }
    },
    {
      "key": "render",
      "n": 10,
      "group": "ship",
      "label": { "en": "Render", "ar": "الإخراج" },
      "dir": "08-render",
      "file": "08-render/masters/master.mp4",
      "gate": null,
      "ask": "script",
      "tool": "filmcraft",
      "lane": "script",
      "owns": ["resolution", "fps"],
      "inputs": ["06-production/editing/edit-project.json"]
    },
    {
      "key": "qa",
      "n": 11,
      "group": "ship",
      "label": { "en": "QA", "ar": "فحص الجودة" },
      "dir": "09-quality",
      "file": "09-quality/qa-report.md",
      "gate": null,
      "ask": "script",
      "tool": "media-qa",
      "lane": "judge",
      "owns": [],
      "inputs": ["08-render/masters/master.mp4"]
    },
    {
      "key": "approval",
      "n": 12,
      "group": "ship",
      "label": { "en": "Approval", "ar": "الاعتماد" },
      "dir": null,
      "file": null,
      "gate": "version",
      "ask": "script",
      "tool": "person",
      "lane": "script",
      "owns": [],
      "inputs": ["09-quality/qa-report.md"]
    },
    {
      "key": "cdn",
      "n": 13,
      "group": "ship",
      "label": { "en": "CDN", "ar": "الرفع" },
      "dir": null,
      "file": null,
      "gate": null,
      "ask": "script",
      "tool": "ship",
      "lane": "script",
      "owns": [],
      "inputs": ["08-render/delivery"]
    },
    {
      "key": "publish",
      "n": 14,
      "group": "ship",
      "label": { "en": "Publish", "ar": "النشر" },
      "dir": "10-publishing",
      "file": "10-publishing/publishing-record.md",
      "gate": "publish",
      "ask": "script",
      "tool": "publish",
      "lane": "script",
      "owns": [],
      "inputs": ["10-publishing/metadata.json"]
    }
  ],
