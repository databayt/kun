{
  "$comment": "The Video department's settings menu (the gear in the Kun app's chat box) as data. Each tab is one clause of one sentence; each choice is defined once here and names the stage that owns it (stages.json). Read by `station.mjs settings|compose|stage` (zero tokens), by `produce lock` (which stage a choice belongs to) and, through them, by the app. A Kind option names the formula it starts. `sets` are formula slots; `line` is the phrase a choice adds to the `settings` slot; `say` is the phrase it adds to the sentence the person sees. Keywords must exist in .claude/vocabulary.json or as a skill; `station.mjs lint` checks all of it. Docs: content/docs/station.mdx.",
  "dept": "video",
  "tabs": [
    {
      "id": "film",
      "label": { "en": "Film", "ar": "الفيلم" },
      "source": "ledger"
    },
    {
      "id": "kind",
      "label": { "en": "Kind", "ar": "النوع" },
      "keys": ["kind"]
    },
    {
      "id": "audience",
      "label": { "en": "Audience", "ar": "الجمهور" },
      "keys": ["audience", "version"]
    },
    {
      "id": "format",
      "label": { "en": "Format", "ar": "الصيغة" },
      "keys": ["platform", "ratio", "length", "resolution", "fps"]
    },
    {
      "id": "style",
      "label": { "en": "Style", "ar": "الأسلوب" },
      "keys": ["look", "voice", "captions", "music"]
    },
    {
      "id": "stages",
      "label": { "en": "Stages", "ar": "المراحل" },
      "source": "ledger"
    }
  ],
