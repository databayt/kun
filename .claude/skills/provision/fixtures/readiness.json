{
  "version": "fixture-1",
  "stages": ["identity", "accounts", "foundation", "repos", "agents", "engine", "tools"],
  "steps": [
    {"id": "git-identity", "stage": "identity", "title": {"ar": "هوية git", "en": "Git identity"}, "os": ["darwin", "linux"], "departments": [], "roles": [], "after": [], "human": false, "check": {"probe": "git-identity", "timeoutS": 10}, "fix": {"kind": "auto", "cmd": "git config --global user.name \"$USER\""}, "uninstall": {"kind": "auto", "cmd": "git config --global --unset user.name"}},
    {"id": "github-login", "stage": "accounts", "title": {"ar": "حساب GitHub", "en": "GitHub login"}, "os": ["darwin", "linux"], "departments": [], "roles": [], "after": ["git-identity"], "human": true, "check": {"probe": "gh-auth", "timeoutS": 10}, "fix": {"kind": "terminal", "cmd": "gh auth login"}},
    {"id": "homebrew", "stage": "foundation", "title": {"ar": "هومبرو", "en": "Homebrew"}, "os": ["darwin"], "departments": [], "roles": [], "after": [], "human": false, "check": {"probe": "brew", "timeoutS": 10}, "fix": {"kind": "auto", "cmd": "bash .claude/scripts/onboarding-mac.sh --quiet"}, "uninstall": {"kind": "terminal", "cmd": "echo uninstall-homebrew", "keystone": true}, "update": {"cmd": "brew update", "cadence": "daily", "auto": true}},
    {"id": "kun-repo", "stage": "repos", "title": {"ar": "مستودع كن", "en": "Kun repo"}, "os": ["darwin", "linux"], "departments": [], "roles": [], "after": ["github-login"], "human": false, "check": {"probe": "repo-kun", "timeoutS": 10}, "fix": {"kind": "auto", "cmd": "git clone https://github.com/databayt/kun ~/kun"}, "uninstall": {"kind": "auto", "cmd": "bash .claude/scripts/kun-trash repo kun"}},
    {"id": "agent-code", "stage": "agents", "title": {"ar": "Claude Code", "en": "Claude Code"}, "os": ["darwin", "linux"], "departments": [], "roles": [], "after": ["homebrew"], "human": false, "check": {"probe": "agent-code", "timeoutS": 10}, "fix": {"kind": "auto", "cmd": "npm i -g @anthropic-ai/claude-code"}, "uninstall": {"kind": "auto", "cmd": "npm uninstall -g @anthropic-ai/claude-code"}, "update": {"cmd": "claude update", "cadence": "weekly", "auto": false}},
    {"id": "engine-sync", "stage": "engine", "title": {"ar": "إعداد المحرك", "en": "Engine config"}, "os": ["darwin", "linux"], "departments": [], "roles": ["engineer"], "after": ["kun-repo"], "human": false, "check": {"probe": "engine", "timeoutS": 10}, "fix": {"kind": "auto", "cmd": "bash .claude/scripts/setup.sh --quiet"}},
    {"id": "hogwarts-env", "stage": "tools", "title": {"ar": "بيئة هوغورتس", "en": "Hogwarts env"}, "os": ["darwin"], "departments": ["hogwarts"], "roles": [], "after": [], "human": false, "check": {"probe": "hogwarts", "timeoutS": 10}, "fix": {"kind": "link", "url": "https://kun.databayt.org/docs"}},
    {"id": "win-tool", "stage": "tools", "title": {"ar": "أداة ويندوز", "en": "Windows tool"}, "os": ["win32"], "departments": [], "roles": [], "after": [], "human": false, "check": {"probe": "win", "timeoutS": 10}, "fix": {"kind": "request", "message": "ask"}}
  ]
}
