# engine
p_engine_manifest() { [ -f "$CLAUDE_DIR/.kun-manifest.json" ] && ok "manifest present" || bad "no ~/.claude/.kun-manifest.json"; }
p_engine_health() {
    local out e w
    out="$(bash "$SCRIPT_DIR/health.sh" --json 2>/dev/null)" || true
    e="$(echo "$out" | jq -r '.errors' 2>/dev/null)"
    [ -n "$e" ] && [ "$e" != null ] || { bad "health.sh gave no verdict"; return; }
    w="$(echo "$out" | jq -r '.warnings')"
    [ "$e" -eq 0 ] && ok "green ($w warnings)" || bad "$e errors, $w warnings"
}
p_engine_mcp() {
    has claude || return 2
    local n want
    n="$(claude mcp list 2>/dev/null | grep -cE ' - (✔|✓|✗|!|⚠)')"
    want="$(jq -r '.counts.project_mcp // 10' "$KUN_ROOT/.claude/engine.json" 2>/dev/null)"
    [ "$n" -ge "$want" ] && ok "$n registered (expected $want+)" || bad "$n registered (expected $want+)"
}
p_engine_browser_mcp() {
    has claude || return 2
    claude mcp list 2>/dev/null | grep -qE '^browser:' && ok "browser MCP registered" || bad "no browser MCP (run /mcp-doctor)"
}
p_engine_mirror() {
    has node || return 2
    node "$SCRIPT_DIR/mirror-agents.mjs" --check >/dev/null 2>&1 && ok "mirrors in sync" || bad "agent mirrors drifted"
}
p_engine_maintain() {
    launchctl list 2>/dev/null | grep -q "com.databayt.kun-maintain" || { bad "heartbeat not armed"; return; }
    local fresh; fresh="$(find "$CLAUDE_DIR/logs" -name 'maintain-*.log' -mmin -2880 2>/dev/null | head -1)"
    [ -n "$fresh" ] && ok "armed, ran in the last 48h" || bad "armed but no run in 48h"
}
# engine fresh: the manifest is under 7 days old and kun has not moved 50+ commits since it
p_engine_fresh() {
    local m="$CLAUDE_DIR/.kun-manifest.json" ts ep now days kdir n
    has jq && [ -f "$m" ] || { bad "no manifest"; return; }
    ts="$(jq -r '.ts // empty' "$m")"
    ep="$(date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$ts" +%s 2>/dev/null || date -u -d "$ts" +%s 2>/dev/null)"
    [ -n "$ep" ] || { bad "manifest has no readable ts"; return; }
    now="$(date +%s)"; days=$(( (now - ep) / 86400 ))
    [ "$days" -le 7 ] || { bad "manifest $days days old (limit 7)"; return; }
    if kdir="$(repo_found kun)"; then
        n="$(git -C "$kdir" rev-list --count --since="$ts" HEAD 2>/dev/null)"
        [ "${n:-0}" -le 50 ] || { bad "kun moved $n commits since the manifest (limit 50)"; return; }
    fi
    ok "manifest ${days}d old"
}
p_engine_hooks() {
    local f="$CLAUDE_DIR/settings.json" h missing=""
    [ -f "$f" ] || { bad "no ~/.claude/settings.json"; return; }
    for h in session-start-reports block-context block-guard block-destructive-bash route-guard; do
        grep -q "$h.sh" "$f" 2>/dev/null || missing="$missing $h"
    done
    [ -z "$missing" ] && ok "5 hooks wired" || bad "settings.json lacks:$missing"
}
p_engine_rules() {
    local r missing=""
    for r in github-workflow block-protocol patterns delegation; do
        [ -f "$CLAUDE_DIR/rules/$r.md" ] || missing="$missing $r"
    done
    [ -z "$missing" ] && ok "4 global rules present" || bad "missing rules:$missing"
}
# department pack: every skill and agent in departments/<dept>/pack.json is installed in ~/.claude
pack_probe() {
    local d="$1" f="$KUN_ROOT/departments/$1/pack.json" item name missing="" n=0
    has jq && [ -f "$f" ] || { skip "no pack.json for $d"; return; }
    for item in $(jq -r '.items[]' "$f"); do
        name="${item#*:}"; n=$((n+1))
        case "$item" in
            skill:*) [ -f "$CLAUDE_DIR/skills/$name/SKILL.md" ] || missing="$missing $item" ;;
            agent:*) [ -f "$CLAUDE_DIR/agents/$name.md" ] || missing="$missing $item" ;;
        esac
    done
    [ -z "$missing" ] && ok "$n items installed" || bad "not installed:$missing"
}
p_pack_tech() { pack_probe tech; }
p_pack_business() { pack_probe business; }
p_pack_sales() { pack_probe sales; }
p_pack_marketing() { pack_probe marketing; }
p_pack_video() { pack_probe video; }
p_pack_image() { pack_probe image; }
p_pack_support() { pack_probe support; }
p_pack_rnd() { pack_probe rnd; }
p_engine_devices() {
    launchctl list 2>/dev/null | grep -q "com.databayt.claude-rc" && ok "Remote Control armed" || bad "devices lane not armed"
}
