p_claude_cli() { has claude && ok "$(claude --version 2>/dev/null | head -1)" || bad "claude not installed"; }
# launchers — each checks the EXACT command (bypass flag included) inside the managed block
launcher_probe() {
    local id="$1" want bin rc
    declare -F agents_launcher_line >/dev/null || { bad "lib/agents.sh missing"; return; }
    agents_launcher_allowed "$id" || { skip "not in this profile's launchers"; return; }
    want="$(agents_launcher_line "$id")" || { bad "no $id in launchers.json"; return; }
    bin="$(echo "$want" | sed -E "s/^alias $id='([^ ']*).*/\1/")"
    if [ "$id" != c ] && ! has "$bin"; then skip "$bin not installed"; return; fi
    for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
        [ -f "$rc" ] || continue
        awk -v w="$want" '
            /^# BEGIN databayt agents/ { b=1; next }
            /^# END databayt agents/   { b=0; next }
            b && substr($0,1,length(w))==w && (length($0)==length(w) || substr($0,length(w)+1,1)==" ") { f=1 }
            END { exit !f }' "$rc" && { ok "$want"; return; }
    done
    bad "missing or wrong in the managed block: $want"
}
p_launcher_c() { launcher_probe c; }
p_launcher_a() { launcher_probe a; }
p_launcher_o() { launcher_probe o; }
p_launcher_h() { launcher_probe h; }
p_claude_desktop() { app "Claude.app" && ok "installed" || bad "Claude Desktop not installed"; }
