# Per-OS overrides: linux/windows probes are added here without touching the macOS set.
# shellcheck disable=SC1090
[ -f "$SCRIPT_DIR/lib/ready-$OS_KEY.sh" ] && . "$SCRIPT_DIR/lib/ready-$OS_KEY.sh"

fn_for() { echo "p_$(echo "$1" | sed 's/[^A-Za-z0-9]/_/g')"; }

run_raw() {
    local fn out rc; fn="$(fn_for "$1")"
    if declare -F "$fn" >/dev/null; then
        out="$("$fn" 2>/dev/null)"; rc=$?
        echo "$out" | head -1 | tr -d '\r'; return $rc
    fi
    echo "no probe for $1 on $OS_KEY"; return 2
}

timeout_for() { jq -r --arg p "$1" '[.steps[]|select(.check.probe==$p)|.check.timeoutS][0] // 15' "$CATALOG" 2>/dev/null; }

run_probe() {
    local t out rc; t="$(timeout_for "$1")"
    out="$(perl -e 'alarm shift; exec @ARGV' "${t:-15}" bash "$SELF" --raw "$1" 2>/dev/null </dev/null)"; rc=$?
    if [ "$rc" -eq 142 ] || [ "$rc" -eq 14 ]; then echo "timeout after ${t}s"; return 1; fi
    [ "$rc" -gt 2 ] && rc=1
    echo "$out" | head -1; return "$rc"
}

catalog_probes() {
    local role; role="$(detect_role)"
    jq -r --arg os "$OS_KEY" --arg role "$role" '.steps[]
        | select((.os|index($os)) != null)
        | select($role=="unknown" or (.roles|index("*")) != null or (.roles|index($role)) != null)
        | .check.probe' "$CATALOG"
}

# run_many: probe ids on stdin, in parallel → JSON [{id, exit, detail}]
run_many() {
    local tmp id i=0 j=0 arr="[]"; tmp="$(mktemp -d)"
    while read -r id; do
        [ -n "$id" ] || continue
        ( out="$(run_probe "$id")"; rc=$?; printf '%s' "$out" > "$tmp/$i.d"; echo "$rc" > "$tmp/$i.r"; echo "$id" > "$tmp/$i.i" ) &
        i=$((i+1))
    done
    wait
    while [ "$j" -lt "$i" ]; do
        arr="$(jq -c --arg id "$(cat "$tmp/$j.i")" --argjson ex "$(cat "$tmp/$j.r")" --rawfile d "$tmp/$j.d" \
            '. + [{id:$id, exit:$ex, detail:$d}]' <<<"$arr")"
        j=$((j+1))
    done
    rm -rf "$tmp"
    echo "$arr"
}
all_run() { run_many < <(catalog_probes); }

# ── The doctor ──────────────────────────────────────────────────────────────
gate_departments() { # csv: --departments, $KUN_DEPARTMENTS, the profile, else every department
    local csv="${GATE_DEPTS:-${KUN_DEPARTMENTS:-}}" pf
    if [ -z "$csv" ] && declare -F agents_profile_file >/dev/null; then
        pf="$(agents_profile_file)"
        [ -n "$pf" ] && csv="$(jq -r '(.departments // [.department]) | map(select(.)) | join(",")' "$pf" 2>/dev/null)"
    fi
    [ -n "$csv" ] || csv="$(for f in "$KUN_ROOT"/departments/*/pack.json; do basename "$(dirname "$f")"; done | paste -sd, -)"
    echo "$csv"
}
gate_probes() { # probe ids of the gate steps that apply to the departments csv ($1)
    jq -r --arg os "$OS_KEY" --argjson depts "$(jq -cn --arg c "$1" '$c|split(",")')" '.steps[]
        | select(.gate != null and .gate != false)
        | select((.os|index($os)) != null)
        | select((.gateFor // .departments) as $g | ($g|index("*")) != null or any($g[]; . as $x | $depts|index($x)))
        | .check.probe' "$CATALOG"
}
gate_json() { # → {pass, level, departments, failing[], core[], extra[], details[], steps[], at}
    local depts res tiers
    depts="$(gate_departments)"
    res="$(run_many < <(gate_probes "$depts"))"
    # probe id → tier ("core" | "extra"; a legacy `gate: true` counts as core)
    tiers="$(jq -c '[.steps[] | select(.gate != null and .gate != false) | {key: .check.probe, value: (if .gate == "extra" then "extra" else "core" end)}] | from_entries' "$CATALOG")"
    jq -c --arg depts "$depts" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --slurpfile cat "$CATALOG" --argjson tiers "$tiers" '
        ([.[] | select(.exit == 1)]) as $f
        | ([$f[] | select(($tiers[.id] // "core") == "core") | .id]) as $core
        | ([$f[] | select(($tiers[.id] // "core") == "extra") | .id]) as $extra
        | {pass: (($core|length) == 0),
           level: (if ($core|length) > 0 then "red" elif ($extra|length) > 0 then "orange" else "green" end),
           departments: ($depts|split(",")),
           failing: [$f[].id],
           core: $core,
           extra: $extra,
           details: [$f[] | . as $r | ($cat[0].steps[] | select(.check.probe == $r.id)) as $s
                     | {id: $r.id, tier: ($tiers[$r.id] // "core"), detail: $r.detail, kind: ($s.fix.kind // "human"), fix: ($s.fix.cmd // ""), title: $s.title.en}],
           steps: .,
           at: $at}' <<<"$res"
}
gate_print() { # human face of gate_json ($1): GREEN | ORANGE (n extras) | RED (n core)
    local level; level="$(jq -r '.level' <<<"$1")"
    local rows='(.details[] | select(.tier == $t) | "  ✗ \(.id)  \(.detail)\n      fix: " + (if .kind=="auto" and .fix != "" then .fix else "(\(.kind) step — see the Setup page in Machine)" end))'
    case "$level" in
        green) jq -r '"GREEN  (departments: \(.departments|join(", ")) · \(.steps|length) gate steps)"' <<<"$1" ;;
        orange) jq -r --arg t extra "\"ORANGE (\(.extra|length) extras) — contribute, with a warning\", $rows" <<<"$1" ;;
        *) jq -r --arg t core "\"RED (\(.core|length) core) — contribution blocked until fixed\", $rows" <<<"$1"
           jq -r --arg t extra "(if (.extra|length) > 0 then \"also missing (extras):\" else empty end), $rows" <<<"$1" ;;
    esac
}
gate_fix() { # run the auto fixes of the failing steps ($1 = gate json), each distinct command once
    local cmd
    while IFS= read -r cmd; do
        [ -n "$cmd" ] || continue
        echo "  → $cmd" >&2
        ( cd "$KUN_ROOT" && bash -c "$cmd" >/dev/null 2>&1 ) || echo "    (exit non-zero)" >&2
    done < <(jq -r '[.details[] | select(.kind=="auto" and .fix != "") | .fix] | unique[]' <<<"$1")
}
gate_main() {
    local json=0 fix=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) json=1 ;;
            --fix) fix=1 ;;
            --departments) GATE_DEPTS="$2"; shift ;;
            --departments=*) GATE_DEPTS="${1#*=}" ;;
        esac
        shift
    done
    has jq || { echo "kun-ready: jq required" >&2; exit 1; }
    local g; g="$(gate_json)"
    if [ "$fix" = 1 ] && [ "$(jq -r '.level' <<<"$g")" != green ]; then
        gate_fix "$g"
        g="$(gate_json)"
    fi
    if [ "$json" = 1 ]; then echo "$g"; else gate_print "$g"; fi
    [ "$(jq -r '.pass' <<<"$g")" = true ]
}

# ── Launchers ───────────────────────────────────────────────────────────────
fix_launchers() {
    declare -F agents_write_alias_block >/dev/null || { echo "kun-ready: lib/agents.sh missing" >&2; return 1; }
    local rc
    [ -f "$HOME/.zshrc" ] || [ -f "$HOME/.bashrc" ] || : > "$HOME/.zshrc"
    for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
        [ -f "$rc" ] && cp -p "$rc" "$rc.kun-backup"
    done
    agents_write_alias_block all installed
    for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
        [ -f "$rc" ] || continue
        echo "$rc: $(awk '/^# BEGIN databayt agents/{b=1;next} /^# END databayt agents/{b=0} b && /^alias /{printf "%s ", substr($2,1,1)}' "$rc")(backup $rc.kun-backup)"
    done
}

case "${1:-}" in
    --raw) run_raw "$2"; exit $? ;;
    --list) jq -r '.steps[].check.probe' "$CATALOG"; exit 0 ;;
    --repos-dir) repos_dir; exit 0 ;;
    --repo-path) repo_path "$2"; exit 0 ;;
    --gate) shift; gate_main "$@"; exit $? ;;
    --fix-launchers) fix_launchers; exit $? ;;
    --all)
        has jq || { echo "kun-ready: jq required" >&2; exit 1; }
        res="$(all_run)"
        if [ "${2:-}" = "--json" ]; then echo "$res"; exit 0; fi
        echo "$res" | jq -r '.[] | (if .exit==0 then "  ✓ " elif .exit==2 then "  - " else "  ✗ " end) + .id + "  " + .detail'
        echo "$res" | jq -r '"  pass \([.[]|select(.exit==0)]|length) · fail \([.[]|select(.exit==1)]|length) · skip \([.[]|select(.exit==2)]|length)"'
        exit 0 ;;
    ""|-h|--help) sed -n 2,19p "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) run_probe "$1"; exit $? ;;
esac
