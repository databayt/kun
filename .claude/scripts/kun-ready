    has jq && [ -f "$f" ] && n="$(jq '.mcpServers // {} | length' "$f" 2>/dev/null)" && [ "${n:-0}" -ge 1 ] \
        && ok "$n MCP servers linked" || bad "Desktop MCP config missing or empty"
}
