#!/bin/bash
# =============================================================================
# kun-ready — readiness probes for one computer, driven by .claude/machine/readiness.json
# =============================================================================
# Shared by `onboarding-mac.sh --doctor` and the Machine desktop app.
#
#   kun-ready <probe>              run one probe        exit 0 pass · 1 fail · 2 not applicable
#                                  stdout = ONE line of detail (never a secret value)
#   kun-ready --list               probe ids (catalog order)
#   kun-ready --all [--json]       every catalog step for this OS (and role, when known):
#                                  text table, or [{id, exit, detail}]
#   kun-ready --repos-dir          the repos directory (installer state, else $HOME)
#   kun-ready --repo-path <repo>   where <repo> lives (or should be cloned)
#   kun-ready --gate [--json] [--fix] [--departments a,b]
#                                  THE DOCTOR: GREEN (all pass) · ORANGE (only extras fail; exit 0) · RED (a core step fails; exit 1).
#                                  Prints READY TO CONTRIBUTE, or each failing step + its fix. exit 0 ready · 1 not.
#                                  Departments: --departments, else $KUN_DEPARTMENTS, else the profile
#                                  machines/<login>.json (login from Machine settings or $KUN_LOGIN), else all.
#                                  --fix runs the auto fixes, then re-checks. --json: {pass, failing[], at, ...}
#   kun-ready --fix-launchers      rewrite the c/a/o/h block in ~/.zshrc and ~/.bashrc from
#                                  .claude/machine/launchers.json (lines outside the markers kept, backup *.kun-backup)
#
# Env: KUN_ROLE=engineer|business|content|ops overrides role detection.
# Each probe runs under its own timeout (catalog check.timeoutS) and, for --all, in parallel.
#
# Other platforms: add .claude/scripts/lib/ready-<linux|windows>.sh defining p_<id> functions;
# it is sourced after the macOS set and overrides it. A probe with no function for the OS
# returns 2 (not applicable).
# =============================================================================

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SELF")"
KUN_ROOT="${KUN_ROOT:-$(cd "$SCRIPT_DIR/../.." && pwd)}"
CATALOG="$KUN_ROOT/.claude/machine/readiness.json"
CLAUDE_DIR="$HOME/.claude"
case "$(uname -s)" in Darwin) OS_KEY=mac ;; Linux) OS_KEY=linux ;; *) OS_KEY=windows ;; esac

# shellcheck disable=SC1091
[ -f "$SCRIPT_DIR/lib/agents.sh" ] && . "$SCRIPT_DIR/lib/agents.sh"

has() { command -v "$1" >/dev/null 2>&1; }
ok()   { echo "$*"; return 0; }
bad()  { echo "$*"; return 1; }
skip() { echo "${*:-not applicable}"; return 2; }
app()  { [ -d "/Applications/$1" ] || [ -d "$HOME/Applications/$1" ]; }

detect_role() {
    [ -n "${KUN_ROLE:-}" ] && { echo "$KUN_ROLE"; return; }
    local m="$CLAUDE_DIR/mcp.json"
    [ -f "$m" ] || { echo unknown; return; }
    if grep -q '"shadcn"' "$m"; then echo engineer
    elif grep -q '"linear"' "$m"; then echo business
    elif grep -q '"figma"' "$m"; then echo content
    elif grep -q '"posthog"' "$m"; then echo ops
    else echo unknown; fi
}

repos_dir() {
    local f d=""
    if [ "$OS_KEY" = mac ]; then f="$HOME/Library/Application Support/Databayt/installer-state.json"
    else f="${XDG_CONFIG_HOME:-$HOME/.config}/databayt/installer-state.json"; fi
    if [ -f "$f" ] && has jq; then d="$(jq -r '.reposDir // empty' "$f" 2>/dev/null)"; fi
    d="${d/#\~/$HOME}"
    echo "${d:-$HOME}"
}
repo_path() { echo "$(repos_dir)/$1"; }
repo_found() {
    local r="$1" p
    for p in "$(repo_path "$r")" "$HOME/$r"; do [ -d "$p/.git" ] && { echo "$p"; return 0; }; done
    return 1
}

# ── Probes (macOS) ──────────────────────────────────────────────────────────
# identity
p_gh_installed() { has gh && ok "$(gh --version | head -1)" || bad "gh not installed"; }
p_gh_auth() { has gh || return 2; gh auth status >/dev/null 2>&1 && ok "signed in" || bad "not signed in"; }
p_github_org() {
    has gh || return 2
    local s; s="$(gh api user/memberships/orgs/databayt --jq .state 2>/dev/null)"
    [ "$s" = active ] && ok "active member" || bad "membership: ${s:-none}"
}
p_github_ssh() {
    local out; out="$(ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new -T git@github.com 2>&1)"
    echo "$out" | grep -qi "successfully authenticated" && ok "ssh key accepted" || bad "no accepted ssh key"
}
p_git_identity() {
    local n e; n="$(git config --global user.name)"; e="$(git config --global user.email)"
    [ -n "$n" ] && [ -n "$e" ] && ok "name and email set" || bad "git user.name/user.email missing"
}
# accounts
p_anthropic_login() {
    has jq && [ -f "$HOME/.claude.json" ] && jq -e '.oauthAccount' "$HOME/.claude.json" >/dev/null 2>&1 \
        && ok "signed in" || bad "no Anthropic sign-in in ~/.claude.json"
}
p_mobile_app() { skip "human step — confirm on the phone"; }
p_slack_joined() { skip "human step — confirm in Slack"; }
p_mail_company() { skip "human step — sign in to the company mailbox (privateemail.com)"; }
p_figma_login() { skip "human step — confirm Figma is signed in"; }
p_secrets_gist() {
    local f="$CLAUDE_DIR/.env" n
    [ -f "$f" ] || { bad "~/.claude/.env missing"; return; }
    n="$(grep -cE '^[A-Za-z_][A-Za-z0-9_]*=' "$f")"
    [ "${n:-0}" -ge 5 ] && ok "$n keys present" || bad "only ${n:-0} keys (need 5+)"
}
crm_probe() {
    has security || return 2
    security find-generic-password -s databayt-twenty -a "$1" >/dev/null 2>&1 \
        && ok "keychain key present" || bad "no keychain key for $1"
}
p_crm_mkan() { crm_probe mkan; }
p_crm_hogwarts() { crm_probe hogwarts; }
p_crm_sijillee() { crm_probe sijillee; }
p_crm_moallimee() { crm_probe moallimee; }
p_crm_databayt() { crm_probe databayt; }
p_crm_api() {
    has security && has curl && has jq || return 2
    local ws key code
    for ws in $(jq -r '.workspaces[].product' "$KUN_ROOT/.claude/memory/crm.json" 2>/dev/null); do
        key="$(security find-generic-password -s databayt-twenty -a "$ws" -w 2>/dev/null)"
        [ -n "$key" ] || continue
        code="$(curl -s -o /dev/null -m 12 -w '%{http_code}' -H "Authorization: Bearer $key" \
            "https://crm-api.databayt.org/rest/people?limit=1")"
        [ "$code" = 200 ] && ok "REST 200 ($ws)" || bad "REST $code ($ws)"
        return
    done
    bad "no workspace key to test with"
}
p_cloudflare_login() { has wrangler || { bad "wrangler not installed"; return; }
    wrangler whoami 2>&1 | grep -qi "logged in" && ok "signed in" || bad "wrangler not signed in"; }
p_vercel_login() { has vercel || { bad "vercel CLI not installed"; return; }
    vercel whoami >/dev/null 2>&1 && ok "signed in" || bad "vercel not signed in"; }
p_aws_login() { has aws || { bad "aws CLI not installed"; return; }
    aws sts get-caller-identity >/dev/null 2>&1 && ok "credentials valid" || bad "no valid AWS credentials"; }
p_neon_login() {
    if has neonctl && neonctl me >/dev/null 2>&1; then ok "signed in"; return 0; fi
    grep -qE '^NEON_API_KEY=.+' "$CLAUDE_DIR/.env" 2>/dev/null && { ok "API key present"; return 0; }
    bad "no Neon access"
}
