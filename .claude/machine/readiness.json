{
  "version": 1,
  "note": "Readiness catalog. Probes: .claude/scripts/kun-ready <probe>. Shared by onboarding-mac.sh --doctor and the Machine app.",
  "stages": [
    "identity",
    "accounts",
    "foundation",
    "repos",
    "agents",
    "engine",
    "tools"
