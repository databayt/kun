  "steps": [
    {
      "id": "gh.installed",
      "stage": "identity",
      "title": {
        "ar": "أداة GitHub مثبتة",
        "en": "GitHub CLI installed"
      },
      "os": [
        "mac"
      ],
      "departments": [
        "*"
      ],
      "roles": [
        "*"
      ],
      "after": [],
      "human": false,
      "check": {
        "probe": "gh.installed",
        "timeoutS": 10
      },
      "fix": {
        "kind": "auto",
        "cmd": "brew install gh"
      },
      "update": {
        "cmd": "brew upgrade gh",
        "cadence": "weekly",
        "auto": true
      }
    },
    {
      "id": "gh.auth",
      "stage": "identity",
      "title": {
        "ar": "تسجيل الدخول إلى GitHub",
        "en": "GitHub signed in"
      },
      "os": [
        "mac"
      ],
      "departments": [
        "*"
      ],
      "roles": [
        "*"
      ],
      "after": [
        "gh.installed"
      ],
      "human": true,
      "check": {
        "probe": "gh.auth",
        "timeoutS": 10
      },
      "fix": {
        "kind": "terminal",
        "cmd": "gh auth login -w",
        "message": "Sign in to GitHub in the browser"
      }
    },
    {
      "id": "github.org",
      "stage": "identity",
      "title": {
        "ar": "عضوية منظمة databayt",
        "en": "databayt org membership active"
      },
      "os": [
        "mac"
      ],
      "departments": [
        "*"
      ],
      "roles": [
        "*"
      ],
      "after": [
        "gh.auth"
      ],
      "human": true,
      "check": {
        "probe": "github.org",
        "timeoutS": 15
      },
      "fix": {
        "kind": "link",
        "url": "https://github.com/orgs/databayt/invitation",
        "message": "Accept the databayt org invitation, or ask Abdout to send one"
      }
    },
    {
      "id": "github.ssh",
      "stage": "identity",
      "title": {
        "ar": "مفتاح SSH على GitHub",
        "en": "SSH key on GitHub"
      },
      "os": [
        "mac"
      ],
      "departments": [
        "*"
      ],
      "roles": [
        "*"
      ],
      "after": [
        "gh.auth"
      ],
      "human": false,
      "check": {
        "probe": "github.ssh",
        "timeoutS": 15
      },
      "fix": {
        "kind": "terminal",
        "cmd": "gh auth refresh -h github.com -s admin:public_key && ssh-keygen -t ed25519 -N '' -f ~/.ssh/id_ed25519 && gh ssh-key add ~/.ssh/id_ed25519.pub"
      }
    },
    {
      "id": "git.identity",
      "stage": "identity",
      "title": {
        "ar": "هوية git (الاسم والبريد)",
        "en": "git name and email set"
      },
      "os": [
        "mac"
      ],
      "departments": [
        "*"
      ],
      "roles": [
        "*"
      ],
      "after": [],
      "human": false,
      "check": {
        "probe": "git.identity",
        "timeoutS": 10
      },
      "fix": {
        "kind": "terminal",
        "cmd": "git config --global user.name \"Your Name\" && git config --global user.email you@databayt.org",
        "message": "Set your git name and email"
      }
    },
