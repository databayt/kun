#!/bin/bash
# kun-long — long mode: a goal run step by step on the dispatch bus, every step evidenced on a GitHub issue.
#   kun-long "<goal>" [--repo R] [--to fcc|opencode|claude|codex|agy] [--hours H] [--steps-max N] [--step-timeout MIN] [--private] [--queue] [--machine <login>|any]
#   kun-long status | stop <n|all> | resume <n> | log <n> | run <n>
D="$(cd "$(dirname "$(readlink "$0" || echo "$0")")/../scripts/dispatch" && pwd)"
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
exec node "$D/long.mjs" "$@"
