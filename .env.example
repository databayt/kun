# Kun env template. Copy to .env and fill in. NEVER create .env.local.

# ── Auth ─────────────────────────────────────────────────────────────────
AUTH_SECRET=
# Per-contributor scrypt hash, one per id in components/root/context/config.ts.
# Generate with:  node scripts/hash-password.mjs <contributor-id>
# Format: scrypt$N$r$p$saltHex$hashHex
#
# No default, no fallback, no dev bypass — a contributor with no hash set here
# cannot sign in, in any environment. Required locally too. Server-side only;
# never commit a value (this repo is public, and a hash allows offline attack).
AUTH_PASSWORD_HASH_ABDOUT=
AUTH_PASSWORD_HASH_ALI=
AUTH_PASSWORD_HASH_SAMIA=
AUTH_PASSWORD_HASH_SEDON=

# ── GitHub (report pipeline writes issues here) ───────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_REPO=databayt/kun

# ── Anthropic Claude (Haiku 4.5 for report triage) ────────────────────────
ANTHROPIC_API_KEY=

# ── Neon Postgres — REQUIRED ──────────────────────────────────────────────
# The social queue: drafts, per-channel variants, schedule, metrics. Also what
# lets work wait through a Hermes outage instead of being lost.
# Prisma 7 reads this via prisma.config.ts for migrations and via a driver
# adapter at runtime (src/lib/db.ts) — there is no bare PrismaClient any more.
DATABASE_URL=

# ── Upstash Redis — REQUIRED IN PRODUCTION ────────────────────────────────
# Rate limit + dedup ledger + corroboration counters. Outside development the
# report pipeline REFUSES submissions when these are missing rather than
# accepting unlimited ones. Optional locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare Turnstile — REQUIRED IN PRODUCTION ─────────────────────────
# Captcha for anonymous reports. Outside development a missing secret key means
# anonymous reports are REFUSED, not waved through unverified. Optional locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Report pipeline ───────────────────────────────────────────────────────
# Salt for IP hashing so DB/Upstash leaks don't expose raw IPs.
REPORT_IP_SALT=

# ── Hermes Integration (gateway lane — see /docs/hermes) ─────────────────
# Server-side endpoint the Social Hub actions call (key stays server-side).
HERMES_API_URL=
HERMES_API_KEY=
# Client-visible URL shown in the Social Hub connection panel.
NEXT_PUBLIC_HERMES_API_URL=

# ── Telegram (direct Bot API egress for the Social Hub) ──────────────────
# One-time setup: @BotFather → bot token; create the brand channel; add the
# bot as channel admin. TELEGRAM_CHANNEL_ID is @username or -100… numeric id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# PRIVATE chat for auto-post draft reviews. Never reuse TELEGRAM_CHANNEL_ID here —
# review messages carry a one-click publish link and must not hit the brand channel.
TELEGRAM_REVIEW_CHAT_ID=

# ── Facebook (direct Graph API egress, per product) ──────────────────────
# One Page + one permanent Page token per brand. Requires a Meta **Business**
# app (Consumer apps can never hold Pages permissions) with pages_manage_posts,
# pages_read_engagement, pages_show_list. Suffix = product id, uppercased.
# Prefer tokens minted from the portfolio's System User over a personal grant —
# they carry expires_at: 0 and survive any one person losing their account.
# See /docs/social/channels/facebook and the /facebook skill.
FACEBOOK_PAGE_ID_HOGWARTS=
FACEBOOK_PAGE_ACCESS_TOKEN_HOGWARTS=
FACEBOOK_PAGE_ID_MKAN=
FACEBOOK_PAGE_ACCESS_TOKEN_MKAN=
FACEBOOK_PAGE_ID_DATABAYT=
FACEBOOK_PAGE_ACCESS_TOKEN_DATABAYT=
FACEBOOK_PAGE_ID_BALQALAM=
FACEBOOK_PAGE_ACCESS_TOKEN_BALQALAM=
# Legacy unsuffixed pair — hogwarts fallback only, kept for backward compat.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# ── Instagram (direct Graph API egress, per product) ─────────────────────
# The IG professional account id linked to the brand's Page — from
# GET /{page-id}?fields=instagram_business_account. The token is the SAME
# per-brand FACEBOOK_PAGE_ACCESS_TOKEN_<PRODUCT>, re-minted to also carry
# instagram_basic + instagram_content_publish. Image posts only.
# See /docs/social/channels/instagram (Standard-Access hypothesis + setup).
INSTAGRAM_USER_ID_MKAN=

# ── Auto-post cron (draft → approve → publish; never unattended) ─────────
# Guards /api/social/cron AND signs the one-click approval links. Vercel sends
# it as `Authorization: Bearer $CRON_SECRET`. Required — no secret, no cron.
CRON_SECRET=
# Comma-separated product ids opted in to daily drafting. EMPTY = nothing
# auto-drafts. e.g. hogwarts,databayt
SOCIAL_AUTOPOST_PRODUCTS=
# hermes (default — hands the ask to the gateway) | anthropic (drafts server-side
# via the API; opt-in because engine billing is subscription-only).
SOCIAL_DRAFT_SOURCE=
# When the source is hermes and Hermes is unreachable, set to `anthropic` to
# draft server-side for that run instead of skipping. Opt-in for the same
# billing reason — a Hermes outage never silently starts spending.
SOCIAL_DRAFT_FALLBACK=
SOCIAL_DRAFT_MODEL=
# ar (default, Arabic-first) | en
SOCIAL_DRAFT_LOCALE=
# Hermes channel that receives drafts for review. Default: slack.
SOCIAL_REVIEW_CHANNEL=
# Origin used to build approval links. Defaults to the request origin.
SOCIAL_PUBLIC_URL=
# Gemini Developer API key (free tier — measured 20 requests/day/model,
# D-20260807). Powers the inline draft lane and drain-google; absent means
# every ask queues for the Mac claude drain.
GEMINI_API_KEY=
# `off` reverts the agent window to queue-only drafting (the one-variable
# revert D-20260807 names). Anything else, including unset, means inline ON.
SOCIAL_DRAFT_INLINE=

