// Generates src/lib/machine/profiles.generated.ts from machines/<login>.json and
// departments/<dept>/pack.json. Cloudflare has no fs, so the server imports this module.
// Secrets and hidden lists are deliberately NOT copied. Run: pnpm exec tsx scripts/machine-profiles.mts
import { readFileSync, readdirSync, writeFileSync, existsSync } from "node:fs";
import { join } from "node:path";

const root = join(import.meta.dirname, "..");
const machines = readdirSync(join(root, "machines"))
  .filter((f) => f.endsWith(".json"))
  .map((f) => JSON.parse(readFileSync(join(root, "machines", f), "utf8")))
  .map((m) => ({
    login: m.login,
    name: m.name,
    os: m.os ?? "",
    department: m.department ?? m.departments?.[0] ?? null,
    departments: m.departments ?? [],
    repos: m.repos ?? [],
    catalog: m.access?.catalog ?? "profile",
  }));
const departments = readdirSync(join(root, "departments"))
  .filter((d) => existsSync(join(root, "departments", d, "pack.json")))
  .map((d) => JSON.parse(readFileSync(join(root, "departments", d, "pack.json"), "utf8")))
  .map((p) => ({ name: p.name, repos: p.repos ?? [] }));

writeFileSync(
  join(root, "src/lib/machine/profiles.generated.ts"),
  `// GENERATED by scripts/machine-profiles.mts — do not edit.\nexport const MACHINE_PROFILES = ${JSON.stringify(machines, null, 2)} as const;\nexport const DEPARTMENT_PACKS = ${JSON.stringify(departments, null, 2)} as const;\n`,
);
console.log(`profiles: ${machines.length} machines, ${departments.length} departments`);
