# kun on Cloudflare Containers — image over a prebuilt Next standalone output.
# The build happens on the Mac (scripts/deploy-cloudflare.sh); nothing compiles here.
# docker/Dockerfile is the unrelated remote-dev box and stays untouched.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
# Heap sized for the `basic` instance (1 GiB): Node must GC before the container limit kills it.
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NODE_OPTIONS=--max-old-space-size=768 NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY .next/standalone ./
COPY .next/static ./.next/static
COPY public ./public
COPY cf/entry.cjs ./entry.cjs
# Last layer: the per-deploy stamp (scripts/deploy-cloudflare.sh) that forces a container restart.
COPY .cf-deploy-stamp ./cf-deploy-stamp
EXPOSE 3000
CMD ["node", "entry.cjs"]
