// Social persistence.
//
// Variant-aware from the start, per docs/SOCIAL-AUTOMATION.md: the binding
// constraint is content capacity, not channel count, so the pipeline is built
// around "one core piece → N platform-native variants" rather than N
// disconnected posts. Modelling that later would mean migrating live rows.
//
// This is also the queue. Hermes runs on a personal machine and flaps; without
// somewhere for work to wait, an outage during the 06:00 cron loses that day's
// draft outright. With these tables it just waits.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A core idea, before it is adapted per channel.
model SocialPiece {
  id     String @id @default(cuid())
  /// Product id from components/root/social/products.ts (hogwarts, mkan, …).
  brand  String
  locale String @default("ar")
  /// Where the copy came from: "claude", "anthropic:<model>", "hermes", "human".
  source String @default("human")
  /// True when any attached media was generated. Drives platform AI-disclosure
  /// duties — TikTok requires the flag, and the house rule is stricter.
  aiGenerated Boolean @default(false)

  createdAt DateTime @default(now())
  variants  SocialVariant[]

  @@index([brand, createdAt])
}

enum VariantStatus {
  draft
  /// Awaiting a human decision. The approval link only publishes from here,
  /// which is what makes a link single-use rather than replayable.
  pending
  approved
  scheduled
  /// Claimed by a drain run. Prevents a concurrent run double-posting.
  publishing
  published
  failed
  rejected
}

/// One platform-native adaptation of a piece. The unit that actually publishes.
model SocialVariant {
  id      String      @id @default(cuid())
  piece   SocialPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  pieceId String

  /// Channel id from components/root/social/config.ts.
  channel  String
  text     String
  /// LEGACY single-media column — code dual-writes it (first URL) and reads
  /// mediaUrls first. Drop only after every deployed reader is array-aware.
  mediaUrl String?
  /// Ordered media set, publicly reachable — platforms fetch the URLs
  /// themselves. Images and/or one video; kind is inferred from extension
  /// (lib/media-kind.ts).
  mediaUrls String[] @default([])

  status VariantStatus @default(draft)

  /// When a scheduled variant becomes eligible for the drain.
  scheduledFor DateTime?
  publishedAt  DateTime?
  /// Bounded so a permanently failing channel cannot retry forever.
  attempts     Int       @default(0)
  /// Last per-channel outcome from deliverPost, for display and debugging.
  result       String?
  /// Platform-side id, where the API returns one.
  externalId   String?

  /// Last successful metrics read. Null means never fetched.
  metricsFetchedAt DateTime?
  /// Bounded, so a transport failure cannot retry forever.
  metricsAttempts  Int       @default(0)
  /// The last metrics failure verbatim, for a human reading the row.
  metricsError     String?
  /// Terminal: a missing permission, a retired metric name, or no Page token.
  /// Retrying cannot help — the fix is a token or a code change. A boolean
  /// rather than `attempts >= MAX` because the two exhaustion rules differ: a
  /// permission failure is terminal at the first attempt, a transport failure
  /// is not terminal until the last.
  metricsGaveUp    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metrics SocialMetric[]

  /// The drain query: due, eligible work in scheduled order.
  @@index([status, scheduledFor])
  /// The metrics query: published variants due for a numbers refresh.
  @@index([status, metricsFetchedAt])
  @@index([pieceId])
}

/// Reach and engagement pulled back per variant. Without this the strategy's
/// "zero signal after 3 months" kill criteria cannot be evaluated at all.
///
/// A TIME SERIES, deliberately — there is no @@unique([variantId]), and the
/// index is [variantId, fetchedAt]. Reach grows: two readings at two times are
/// both true and the delta between them is the interesting number. Adding a
/// unique constraint to enable an upsert would flatten the growth curve to a
/// single point. Insert, never upsert.
model SocialMetric {
  id        String        @id @default(cuid())
  variant   SocialVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String

  /// post_total_media_view_unique — closest available stand-in for reach.
  /// Not comparable to a pre-2025 figure; see lib/facebook-metrics.ts.
  reach Int @default(0)
  /// post_media_view — total media views.
  views Int @default(0)
  /// UTM-attributed clicks. Written as 0 until an analytics destination is
  /// wired, rather than invented from a platform number that means something
  /// else.
  clicks Int @default(0)

  reactions Int @default(0)
  comments  Int @default(0)
  shares    Int @default(0)

  fetchedAt DateTime @default(now())

  @@index([variantId, fetchedAt])
}

enum DraftRequestStatus {
  /// Waiting for a Claude Code session to answer it.
  pending
  /// Copy is written and readable in `ar` / `en`.
  answered
  /// Whoever picked it up could not write it; `note` says why.
  failed
  /// Approved from the review queue into a SocialPiece. Terminal.
  consumed
  /// A human decided not to use it; `note` says why. Terminal.
  dismissed
}

/// A contributor's ask for copy, waiting on the Max pool.
///
/// The Hub's agent window does NOT call the Anthropic API: the engine's billing
/// posture is subscription-only, so there are no credits for an API key to
/// spend (a live test on 2026-07-30 confirmed the key in Vercel is rejected —
/// see .claude/memory/decisions/2026-07-30-in-app-draft-spend.md). Instead the
/// window records the ask here and a Claude Code session on a human's machine
/// answers it against the Max subscription — the same inverted arrow the cron
/// uses for Hermes, for the same reason: Vercel cannot reach the thing that
/// does the writing, so the thing that does the writing reaches in.
///
/// Deliberately not a SocialPiece: nothing has been written yet, and a piece
/// with no copy would pollute the ledger the Hub and metrics both read.
model SocialDraftRequest {
  id String @id @default(cuid())

  /// Product registry id — hogwarts · mkan · databayt · sijillee · moalimee.
  brand String
  /// The contributor's ask, verbatim.
  brief String
  /// Who asked, for the answering session's context. Contributor email.
  requestedBy String?

  status DraftRequestStatus @default(pending)

  /// The answer: Arabic crafted first, English as its sibling.
  ar String?
  en String?
  /// Who answered, e.g. "claude-code:abdout". Or why it failed.
  note String?
  /// The draft's media half — library picks or CDN renders, attached at ask
  /// time by a contributor or at answer time by the drafting session. A full
  /// draft is copy AND/OR media: any of the two may be empty, never both.
  mediaUrls String[] @default([])

  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  /// The queue read: oldest pending first.
  @@index([status, createdAt])
}

/// Last-seen timestamps for components that call in rather than being called.
///
/// Hermes runs on a personal machine with no public route, so kun can never
/// probe it — the Hub's "Hermes" row only ever showed reachability FROM Vercel,
/// which is permanently false in production and says nothing about whether the
/// gateway is actually alive. A heartbeat written when Hermes polls is the only
/// honest liveness signal available.
model SystemHeartbeat {
  /// Component name, e.g. "hermes".
  key    String   @id
  at     DateTime @updatedAt
  detail String?
}
